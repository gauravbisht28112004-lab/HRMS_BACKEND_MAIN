# =============================================================================
# Finbud HRMS — Environment Variables Template
# =============================================================================
#
# This file is COMMITTED to git as documentation. Copy the variables below
# into wherever your environment loads them from:
#
#   * Local dev (IntelliJ):
#       Run → Edit Configurations → FinbudHrmsApplication → Environment variables
#       Paste them as a single line, separated by semicolons:
#       DB_PASSWORD=postgres;APP_JWT_SECRET=...
#
#   * Local dev (terminal):
#       In PowerShell, before launching:
#       $env:DB_PASSWORD="postgres"; $env:APP_JWT_SECRET="..."
#
#   * Production (Render):
#       Render dashboard → your service → Environment → Add environment variable
#       Add each variable individually.
#
# DO NOT create a real .env file with secret values and commit it. The
# .gitignore already blocks .env, but the safest path is "secrets only live
# in IntelliJ run config and the production hosting dashboard".
#
# =============================================================================
# REQUIRED — app will not start without these
# =============================================================================

# PostgreSQL password.
# Local dev:  matches docker-compose.yml POSTGRES_PASSWORD (= postgres)
# Production: the password from your managed Postgres provider (Neon, RDS, etc.)
DB_PASSWORD=postgres

# JWT signing secret. Must be at least 64 characters (HS512 algorithm needs
# 512 bits of entropy). Generate a fresh one with either:
#   PowerShell:  [Convert]::ToBase64String((1..64 | % { Get-Random -Maximum 256 } | % { [byte]$_ }))
#   Linux/Mac:   openssl rand -base64 64
# NEVER reuse the dev secret in production.
APP_JWT_SECRET=replace-this-with-a-real-64-character-random-base64-string-for-local-dev-only

# =============================================================================
# OPTIONAL — only set if you actually need the feature
# =============================================================================

# Override default Postgres URL/username (defaults work for local docker-compose)
# DB_URL=jdbc:postgresql://localhost:5432/finbud_hrms
# DB_USERNAME=postgres

# Comma-separated list of allowed CORS origins. In prod set to your Vercel URL.
# APP_CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app

# OpenAI key — only needed if you use the AI HR assistant module.
# OPENAI_API_KEY=sk-...

# SMTP credentials for email notifications.
# MAIL_USERNAME=hr-noreply@finbudfinancial.com
# MAIL_PASSWORD=app-password-not-account-password

# S3 / MinIO for profile pictures. If you don't need avatars yet, set:
#   FINBUD_S3_ENABLED=false
# FINBUD_S3_ENABLED=true
# FINBUD_S3_ENDPOINT=http://localhost:9000
# FINBUD_S3_PATH_STYLE=true
# FINBUD_S3_REGION=ap-south-1
# FINBUD_S3_BUCKET=finbud-hrms-avatars
# FINBUD_S3_ACCESS_KEY=minioadmin
# FINBUD_S3_SECRET_KEY=minioadmin

# JWT token lifetimes (defaults: 24h access, 7d refresh).
# Production should override to ~1h access via application-prod.properties.
# APP_JWT_EXPIRATION_MS=3600000
# APP_JWT_REFRESH_EXPIRATION_MS=604800000
